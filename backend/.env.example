PORT=8080
MONGO_URI=mongodb://localhost:27017/tradepulse
JWT_SECRET=tradepulse_jwt_secret_dev_key_12345

# Market Data Mode: SIMULATION
MARKET_DATA_MODE=SIMULATION

# Development/Testing Override: Force active simulation tick loop outside Indian market hours
MARKET_SIMULATION_FORCE_OPEN=false

# Market Data Provider: TRUEDATA | DEV_UNOFFICIAL
MARKET_DATA_PROVIDER=TRUEDATA

# TrueData Market Data Vendor Credentials (REQUIRED when MARKET_DATA_PROVIDER=TRUEDATA)
TRUEDATA_USERNAME=your_truedata_username
TRUEDATA_PASSWORD=your_truedata_password
TRUEDATA_PORT=8084
TRUEDATA_WEBSOCKET_URL=wss://realtime.truedata.in
TRUEDATA_REST_URL=https://api.truedata.in

# Feed Monitoring Configuration
MARKET_DATA_STALE_THRESHOLD_MS=10000
MARKET_DATA_POLL_INTERVAL_MS=3000

# SMTP Email Delivery Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TradePulse" <noreply@tradepulse.app>
